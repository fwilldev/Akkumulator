        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instantáneas se guardan automáticamente una vez al día o mediante «Guardar instantánea»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instantanés sont enregistrés automatiquement une fois par jour ou via « Enregistrer un instantané »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
