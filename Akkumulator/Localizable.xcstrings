    "This build has no iCloud (CloudKit) entitlement. Sign with your team and add the iCloud capability to enable sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Build fehlt die iCloud-Berechtigung (CloudKit). Signiere mit deinem Team und füge die iCloud-Capability hinzu, um den Sync zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no tiene el permiso de iCloud (CloudKit). Firma con tu equipo y añade la capacidad de iCloud para activar la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne dispose pas de l’autorisation iCloud (CloudKit). Signez avec votre équipe et ajoutez la fonctionnalité iCloud pour activer la synchronisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa build non ha l’autorizzazione iCloud (CloudKit). Firma con il tuo team e aggiungi la funzionalità iCloud per attivare la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはiCloud（CloudKit）のエンタイトルメントがありません。同期を有効にするには、チームで署名してiCloud機能を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 iCloud(CloudKit) 권한이 없습니다. 동기화를 활성화하려면 팀으로 서명하고 iCloud 기능을 추가하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não tem a permissão do iCloud (CloudKit). Assine com sua equipe e adicione a capacidade do iCloud para ativar a sincronização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não tem a permissão do iCloud (CloudKit). Assine com a sua equipa e adicione a capacidade do iCloud para ativar a sincronização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本缺少 iCloud（CloudKit）权限。请使用你的团队签名并添加 iCloud 功能以启用同步。"
          }
        }
      }
    },
