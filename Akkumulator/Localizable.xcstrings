    "Snapshots are saved automatically once a day, or via “Save Snapshot”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshots werden einmal täglich automatisch gesichert oder über „Snapshot sichern“."
